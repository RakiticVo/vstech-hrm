@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD09 · Tạo phiếu giải trình / điều chỉnh công\n<size:12>Tầng 1 – Mobile App</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "AttendanceCorrectionScreen /\nCorrectionManageScreen" as S
participant "AttendanceCorrectionModal" as M
end box
box "Thiết bị" #F1F5F9
participant "Camera / Thư viện ảnh\n+ GPS" as DEV
end box
box "Domain" #FEF9E7
participant "GetCorrectionReasons /\nCreateCorrectionRequest\nUseCase" as UC
end box
box "Data" #EEF2FF
participant "RequestsRepositoryImpl\n→ RemoteDataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API\n<size:10>REST · JWT</size>" as API
end box


U -> S : Mở "Giải trình công" (hoặc chạm ngày đỏ trên lịch công)
activate S
S -> UC : GetCorrectionReasonsUseCase()
UC -> REPO : getCorrectionReasons()
REPO -> API : GET /api/TimesheetConfirmRequests/reasons
API --> REPO : TimesheetConfirmRequestType[]\n{code, name, mustHaveNote, mustHaveImage}
REPO --> UC : Right(List‹CorrectionReasonEntity›)
UC --> S : Danh mục lý do: quên chấm công,\nlỗi thiết bị / mạng, công tác ngoài hiện trường…
U -> S : Bấm "Tạo phiếu"
S -> M : show(reasons)
U -> M : Bước 1: chọn ngày phát sinh\nBước 2: chọn vấn đề + số giờ làm thực tế\nBước 3: nhập giải trình, đính kèm ảnh
opt Lý do yêu cầu ảnh minh chứng (mustHaveImage)
  M -> DEV : Chụp / chọn ảnh, lấy vị trí hiện tại
  DEV --> M : imageUrl, latitude, longitude, address
end
M -> M : Kiểm tra theo lý do:\nmustHaveNote → bắt buộc ghi chú\nmustHaveImage → bắt buộc ảnh
M --> S : onConfirm(...)
S -> S : CreateCorrectionParams{employeeCode, workDate, worktime,\nreasonTypeCode, note, imageUrl, latitude, longitude, address}
S -> UC : CreateCorrectionRequestUseCase(params)
UC -> REPO : createCorrectionRequest(params)
REPO -> API : POST /api/TimesheetConfirmRequests\nCreateTimesheetConfirmRequestCommand{employeeCode, workDate,\nworktime, note, imageUrl, latitude, longitude, address, reasonTypeCode}
alt 200 OK
  API --> REPO : ServiceResultResponse{message}
  REPO --> UC : Right(true)
  UC --> S : thành công
  S --> U : "Đã gửi phiếu giải trình – chờ Quản lý xác nhận giờ công"
else 400
  API --> REPO : ServiceResultResponse{message}
  REPO --> UC : Left(ServerFailure)
  UC --> S : Failure
  S --> U : SnackBar lỗi
end
deactivate S
@enduml
