@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 230
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD09 · Phê duyệt đơn: giải trình công, nghỉ phép, tăng ca\n<size:12>Mobile – Phần 1/3: Tải hộp thư phê duyệt</size>
actor "Quản lý" as U
box "Presentation" #E6F4F1
participant "Home / GoRouter" as R
participant "ApprovalsScreen\n+ dialog" as S
participant "ApprovalsAction\nHandler" as H
end box
box "Domain" #FEF9E7
participant "UseCases" as UC
end box
box "Data" #EEF2FF
participant "Approvals / Requests\nRepository → DataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API" as API
end box


hide unlinked

U -> R : Dải "Chờ duyệt" / tab "Phê duyệt"
R -> R : authRedirectGuard: chỉ vai trò Quản lý
R -> S : Mở /approvals
S -> H : loadAllPendingApprovals()
par Future.wait – 3 nguồn
  H -> UC : GetPendingApprovalsUseCase()
  UC -> REPO : getPendingTimesheetApprovals()
  REPO -> API : GET /api/TimesheetConfirmRequests?personal=false
  API --> REPO : phiếu giải trình
else
  H -> UC : GetLeaveRequestsUseCase()
  UC -> REPO : getLeaveRequests()
  REPO -> API : GET /api/LeaveRequests/self?From&To
  API --> REPO : đơn nghỉ phép
else
  H -> UC : GetOvertimeRequestsUseCase()
  UC -> REPO : getOvertimeRequests()
  REPO -> API : GET /api/OvertimeRequests/self?month
  API --> REPO : đơn tăng ca
end
REPO --> UC : entities
UC --> H : 3 danh sách
H -> H : Lọc đơn chờ (status = 0),\nchuẩn hoá ApprovalItem: GC · NP · TC
H --> S : List‹ApprovalItem›
S --> U : Thẻ đơn + lọc: Tất cả · Giải trình · Tăng ca · Nghỉ phép
@enduml
