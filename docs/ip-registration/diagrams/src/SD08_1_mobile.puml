@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD08 · Đăng ký làm thêm giờ (Tăng ca)\n<size:12>Tầng 1 – Mobile App</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "OvertimeRequestScreen /\nOvertimeManageScreen" as S
participant "OvertimeRequestModal" as M
participant "AuthCubit" as AC
end box
box "Domain" #FEF9E7
participant "GetOvertimeTypes /\nCreateOvertimeRequest /\nGetOvertimeRequests UseCase" as UC
end box
box "Data" #EEF2FF
participant "RequestsRepositoryImpl" as REPO
participant "RequestsRemoteDataSource" as DS
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API\n<size:10>REST · JWT</size>" as API
end box


U -> S : Mở "Tăng ca"
activate S
S -> UC : GetOvertimeTypesUseCase()
UC -> REPO : getOvertimeTypes()
REPO -> DS : getOvertimeTypes()
DS -> API : GET /api/OvertimeRequests/self?init=1
API --> DS : overtimeTypes[] {code, name, scale}
DS --> REPO : List‹OvertimeTypeModel›
REPO --> UC : Right(List‹OvertimeTypeEntity›)
UC --> S : Loại tăng ca: ngày thường ×1,5 ·\nngày nghỉ tuần ×2,0 · ngày lễ ×3,0
S -> UC : GetOvertimeRequestsUseCase(month)
UC -> REPO : getOvertimeRequests(month)
REPO -> DS : getOvertimeRequests(month)
DS -> API : GET /api/OvertimeRequests/self?month=yyyy-MM
API --> DS : OvertimeRequestSelfItem[]\n{code, status, date, timeRange, length, overtimeTypeName…}
DS --> REPO : models
REPO --> UC : Right(List‹OvertimeItemEntity›)
UC --> S : Lịch sử + tổng giờ tăng ca trong tháng
U -> S : Bấm "Đăng ký tăng ca"
S -> M : OvertimeRequestModal.show(types)
U -> M : Chọn ngày, giờ bắt đầu – kết thúc,\nloại tăng ca, lý do
M -> M : Tự tính số giờ (length) và\ngiờ quy đổi = length × hệ số
M --> S : onConfirm(date, start, end, length, type, reason)
S -> AC : state.user.employeeCode
S -> S : CreateOvertimeParams{employeeCode, date,\nstartOvertime, endOvertime, length,\novertimeTypeCode, note}
S -> UC : CreateOvertimeRequestUseCase(params)
UC -> REPO : createOvertimeRequest(params)
REPO -> REPO : Map → OvertimeRequestCreateModel
REPO -> DS : createOvertimeRequest(command)
DS -> API : POST /api/OvertimeRequests\nOvertimeRequestVM{employeeCode, date, startOvertime,\nendOvertime, length, overtimeTypeCode, note}
alt 200 OK
  API --> DS : ServiceResultResponse{message}
  DS --> REPO : true
  REPO --> UC : Right(true)
  UC --> S : Right(true)
  S --> U : AppSuccessDialog "Đã gửi đăng ký tăng ca\nngày {dd/MM/yyyy}, {giờ}"
else 400 – vượt giới hạn giờ OT tháng/năm
  API --> DS : ServiceResultResponse{message}
  DS --> REPO : ServerException
  REPO --> UC : Left(ServerFailure)
  UC --> S : Left(Failure)
  S --> U : SnackBar lỗi
end
deactivate S
@enduml
