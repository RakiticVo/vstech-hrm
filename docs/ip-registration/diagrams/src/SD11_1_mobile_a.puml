@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 230
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD11 · Trung tâm thông báo\n<size:12>Mobile – Nhận và xử lý thông báo</size>
actor "Người dùng" as U
box "Presentation" #E6F4F1
participant "Home\n(chuông · Cập nhật mới)" as HA
participant "NotificationsScreen" as S
end box
box "Domain" #FEF9E7
participant "UseCases" as UC
end box
box "Data" #EEF2FF
participant "NotificationsRepository\n→ DataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API" as API
end box


hide unlinked

U -> HA : Trang chủ – khối "Cập nhật mới"
HA -> UC : GetNotificationsUseCase()
UC -> REPO : getNotifications()
REPO -> API : GET /api/BaseNotifications?size&isRead
API --> REPO : {data[], deptData[]}
REPO --> UC : List‹NotificationEntity›
UC --> HA : thông báo mới nhất
U -> HA : Bấm chuông
HA -> S : Mở /notifications
S -> UC : GetNotificationsUseCase()
UC --> S : danh sách
S --> U : Lọc: Tất cả · Phép · Lương · Chấm công · Thưởng…
U -> S : Chạm 1 thông báo
S -> UC : MarkNotificationReadUseCase(id)
UC -> REPO : markAsRead(id)
REPO -> API : GET /api/BaseNotifications/{id}/read
opt "Đọc tất cả"
  S -> UC : MarkAllNotificationsReadUseCase()
  UC -> REPO : markAllAsRead()
  REPO -> API : GET /api/BaseNotifications/read-all
end
@enduml
