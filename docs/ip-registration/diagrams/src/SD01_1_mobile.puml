@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD01 · Đăng nhập và khôi phục phiên làm việc\n<size:12>Tầng 1 – Mobile App</size>
actor "Nhân viên /\nQuản lý" as U
box "Presentation" #E6F4F1
participant "SplashScreen /\nLoginScreen" as S
participant "AuthCubit\n<size:10>core/session</size>" as C
participant "GoRouter\n<size:10>authRedirectGuard</size>" as R
end box
box "Domain" #FEF9E7
participant "CheckAuthUseCase /\nLoginUseCase" as UC
end box
box "Data" #EEF2FF
participant "AuthRepositoryImpl" as REPO
participant "AuthRemoteDataSource" as DS
participant "DioClient\n+ AuthInterceptor" as DIO
participant "FlutterSecureStorage\n<size:10>Keychain / Keystore</size>" as SEC
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API\n<size:10>REST · JWT</size>" as API
end box


== A. Khởi động ứng dụng – khôi phục phiên ==
U -> S : Mở ứng dụng
S -> C : checkAuthStatus()
activate C
C -> C : emit(AuthLoading)
C -> SEC : read(access_token), read(vstech_user_session)
SEC --> C : token, userJson
alt Có token và phiên đã lưu
  C -> UC : CheckAuthUseCase()
  UC -> REPO : checkAuth()
  REPO -> DS : checkAuth()
  DS -> DIO : GET /api/Account/check-auth
  DIO -> SEC : read(access_token)
  DIO -> API : GET /api/Account/check-auth\nAuthorization: Bearer ‹JWT›
  alt 200 OK – token còn hiệu lực
    API --> DIO : 200
    DIO --> DS : Response
    DS --> REPO : true
    REPO --> UC : Right(true)
    UC --> C : Right(true)
    C -> C : UserSession.fromJson(userJson)
    C -> C : emit(Authenticated(user, token, role))
  else 401 Unauthorized – token hết hạn
    API --> DIO : 401
    DIO --> DS : DioException(401)
    DS --> REPO : false
    REPO --> UC : Right(false)
    UC --> C : Right(false)
    C -> SEC : delete(token, refresh_token, session, valid_to)
    C -> C : emit(Unauthenticated)
  end
else Chưa từng đăng nhập
  C -> C : emit(Unauthenticated)
end
deactivate C
C -> R : refreshListenable thông báo đổi trạng thái
R -> R : authRedirectGuard(state)
R --> S : Authenticated → /home (ứng viên → /onboarding/home)\nUnauthenticated → /login

== B. Đăng nhập bằng mã nhân viên + mật khẩu ==
U -> S : Nhập mã NV, mật khẩu, bấm "Đăng nhập"
S -> S : Kiểm tra bắt buộc nhập (trống → SnackBar lỗi)
S -> SEC : Lưu thông tin "Ghi nhớ đăng nhập" (mã hoá)
S -> C : login(username, password)
activate C
C -> C : emit(AuthLoading)
C -> C : Tạo LoginParams\n(deviceId, model, brand, platform,\nversionRelease, versionApp, checkMobile, root)
C -> UC : LoginUseCase(params)
UC -> REPO : login(params)
REPO -> REPO : Map → LoginRequestModel
REPO -> DS : login(request)
DS -> DIO : POST /api/Account
DIO -> API : POST /api/Account\n{username, password, device_id, model, brand,\nplatform, version_release, version_app, check_mobile, root}
alt 200 OK
  API --> DIO : LoginResultViewModel\n{token, validTo, webAllowed, user{employeeCode, employeeName, claims…}}
  DIO --> DS : Response
  DS --> REPO : LoginResultModel.fromJson()
  REPO -> REPO : Map → AuthResultEntity
  REPO --> UC : Right(AuthResultEntity)
  UC --> C : Right(AuthResultEntity)
  C -> C : Xác định vai trò:\nclaims chứa "manager.approve" → Quản lý (QL)\nngược lại → Nhân viên (NV)
  C -> SEC : write(access_token, user_session, token_valid_to, saved_username, saved_password)
  C -> C : emit(Authenticated(user, token, role))
  C -> R : Điều hướng
  R --> S : /home – thanh điều hướng 5 tab theo vai trò\n(QL có thêm tab "Phê duyệt")
else 400 / 401 / 500
  API --> DIO : ApiMessageViewModel{message}
  DIO --> DS : DioException
  DS --> REPO : throw AuthException / ServerException
  REPO --> UC : Left(AuthFailure / ServerFailure)
  UC --> C : Left(Failure)
  C -> C : emit(Unauthenticated(message))
  C --> S : Hiển thị thông báo lỗi
end
deactivate C

== C. Đăng nhập nhanh bằng sinh trắc học (Face ID / Vân tay) ==
U -> S : Bấm nút sinh trắc học
S -> S : local_auth.isDeviceSupported(),\ncanCheckBiometrics, getAvailableBiometrics()
S -> SEC : read(saved_username, saved_password)
S -> S : local_auth.authenticate(localizedReason)
alt Xác thực sinh trắc thành công
  S -> C : login(savedUsername, savedPassword)
  note right of C : Tiếp tục như luồng B
else Huỷ / thất bại
  S --> U : Giữ nguyên màn hình đăng nhập
end
@enduml
