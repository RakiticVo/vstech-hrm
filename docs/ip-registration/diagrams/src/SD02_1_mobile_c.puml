@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 230
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD02 · Chấm công vào / ra ca bằng nhận diện khuôn mặt AI\n<size:12>Mobile – Phần 3/3: Ghi nhận chấm công và biên lai</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "Home / Attendance\n→ FaceScanScreen" as S
participant "AttendanceBloc" as B
end box
box "Thiết bị" #F1F5F9
participant "GPS · Camera" as DEV
end box
box "Domain" #FEF9E7
participant "UseCases" as UC
end box
box "Data" #EEF2FF
participant "FaceAuth / Attendance\nRepository → DataSource" as REPO
end box
box "Máy chủ" #FFF1F2
participant "Face Auth API" as FAPI
participant "HRM Backend API" as API
end box

hide unlinked

B -> UC : CheckIn / CheckOut UseCase\n(lat, lng, bssid, thời điểm)
UC -> REPO : checkIn() / checkOut()
REPO -> API : POST /api/Enrollments/Checkin|Checkout\nEnrollForm{coordinate, local, fingerprint}
alt 200 OK
  API --> REPO : {message, checkin, checkout}
  REPO --> UC : AttendanceRecordEntity\n(đúng giờ / muộn / về sớm)
  UC --> B : record
  B -> UC : GetTodayAttendanceUseCase()
  UC -> REPO : getTodayAttendance()
  REPO -> API : GET /api/Enrollments/info
  API --> REPO : ca, giờ vào/ra, serverTime
  REPO --> UC : AttendanceTodayEntity
  UC --> B : todayAttendance
  B --> S : success
  S --> U : Rung nhẹ + biên lai chấm công
else 400 – vi phạm quy tắc
  API --> REPO : {message}
  REPO --> UC : Left(Failure)
  UC --> B : Failure
  B --> S : failure
  S --> U : Thông báo lỗi, hướng liên hệ HR
end
@enduml
