@startuml

!pragma layout smetana
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 10
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam ArrowColor #0F766E
skinparam componentStyle rectangle
skinparam rectangle {
  BorderColor #0F766E
  BackgroundColor #FFFFFF
}
skinparam package {
  BorderColor #0A544E
  BackgroundColor #F0FDFA
  FontColor #0A544E
}
skinparam node {
  BorderColor #0A544E
  BackgroundColor #F8FAFC
}
skinparam database {
  BorderColor #0A544E
  BackgroundColor #ECFEFF
}
skinparam cloud {
  BorderColor #B45309
  BackgroundColor #FFFBEB
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
}
skinparam class {
  BorderColor #0F766E
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #CCFBF1
  ArrowColor #0F766E
}
skinparam state {
  BorderColor #0F766E
  BackgroundColor #F0FDFA
  ArrowColor #0F766E
}


title Vòng đời 5 trạng thái bản ghi chấm công ngoại tuyến (SyncStatus)
[*] --> recorded : Chấm công khi mất mạng\n(cosine ≥ 0,85)
recorded --> pending : Đưa vào hàng đợi
pending --> syncing : Có mạng / bấm "Đồng bộ"
syncing --> synced : Máy chủ chấp nhận
syncing --> failed : Ngoài geofence 50 m /\nlỗi máy chủ
failed --> syncing : "Thử lại"
synced --> [*]
@enduml
