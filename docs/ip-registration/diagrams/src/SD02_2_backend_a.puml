@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 230
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD02 · Chấm công vào / ra ca bằng nhận diện khuôn mặt AI\n<size:12>Backend – Phần 1/2 (khung – bổ sung sau)</size>
participant "Ứng dụng Mobile" as APP
box "Backend" #FFF1F2
participant "Controller\n<size:10>(JWT · phân quyền)</size>" as CTL
participant "Service\n<size:10>nghiệp vụ</size>" as SVC
end box
box "Dữ liệu" #EEF2FF
database "Database" as DB
end box

box "Dịch vụ khuôn mặt" #FFF1F2
participant "Face Auth Service" as FACE
end box

hide unlinked
APP -> FACE : <b>GET /checkreg/</b>\nCode, AppCode
note over FACE : Trích xuất vector, so khớp,\nlưu trữ: <color:#B91C1C><i>[Backend bổ sung]</i></color>
FACE --> APP : {status, registered, count}
APP -> FACE : <b>POST /verify/</b>\nmultipart: Code, AppCode, file
note over FACE : Trích xuất vector, so khớp,\nlưu trữ: <color:#B91C1C><i>[Backend bổ sung]</i></color>
FACE --> APP : {status, match, similarity}
APP -> CTL : <b>POST /api/Enrollments/Checkin | Checkout</b>\nEnrollForm{coordinate, local, fingerprint, time, date}
CTL -> SVC : EnrollmentsController <color:#B91C1C><i>[Backend bổ sung]</i></color>
SVC -> DB : Enrollments, TimeSheets, Shifts (dự kiến)
DB --> SVC : dữ liệu
SVC --> CTL : kết quả <color:#B91C1C><i>[Backend bổ sung]</i></color>
CTL --> APP : EnrollActionResponse{message, checkin, checkout}\n· 400 {message}
@enduml
