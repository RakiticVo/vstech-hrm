@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD03 · Đăng ký / cập nhật dữ liệu khuôn mặt (Face Enrollment)\n<size:12>Tầng 1 – Mobile App</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "Profile / FaceScan\nScreen" as P
participant "FaceEnrollmentScreen" as S
end box
box "Thiết bị" #F1F5F9
participant "CameraController" as CAM
end box
box "Domain" #FEF9E7
participant "CheckFaceRegistration /\nRegisterFace / UpdateFace\nUseCase" as UC
end box
box "Data" #EEF2FF
participant "FaceAuthRepositoryImpl" as REPO
participant "FaceAuthRemoteDataSource\n(FaceDioClient)" as DS
end box
box "Máy chủ" #FFF1F2
participant "Face Authentication\nAPI" as FAPI
end box

U -> P : Chọn "Đăng ký khuôn mặt"\n(từ Hồ sơ hoặc hộp thoại chưa đăng ký)
P -> S : push(/profile/face-enrollment)
activate S
S -> UC : CheckFaceRegistrationUseCase(code)
UC -> REPO : checkRegistration(code)
REPO -> DS : checkRegistration(code)
DS -> FAPI : GET /checkreg/?Code&AppCode
FAPI --> DS : {status, registered, count, message}
DS --> REPO : FaceCheckRegModel
REPO --> UC : Right(FaceCheckRegEntity)
UC --> S : isRegistered, số mẫu đã lưu
S --> U : Hiển thị trạng thái + hướng dẫn chụp\n(đủ sáng, không đeo khẩu trang, nhìn thẳng)
S -> CAM : Khởi tạo camera trước
U -> S : Bấm chụp
S -> CAM : takePicture()
CAM --> S : xFile.path
alt Đã có dữ liệu khuôn mặt
  S -> UC : UpdateFaceUseCase(code, imagePath)
  UC -> REPO : updateFace(code, imagePath)
  REPO -> DS : updateFace(...)
  DS -> FAPI : POST /update/  multipart\n{Code, AppCode, file = update_face.jpg}
else Đăng ký lần đầu
  S -> UC : RegisterFaceUseCase(code, imagePath)
  UC -> REPO : registerFace(code, imagePath)
  REPO -> DS : registerFace(...)
  DS -> FAPI : POST /register/  multipart\n{Code, AppCode, files[] = register_face.jpg}
end
FAPI --> DS : {status, message}
DS --> REPO : FaceActionResponseModel
alt status = true
  REPO --> UC : Right(true)
  UC --> S : thành công
  S --> U : Thông báo đăng ký thành công
  S --> P : pop(true)
  P -> P : Gửi lại PrepareFaceScanEvent\n→ sẵn sàng chấm công
else Lỗi (ảnh không hợp lệ / 422)
  REPO --> UC : Left(ServerFailure(message))
  UC --> S : Failure
  S --> U : Báo lỗi, cho phép chụp lại
end
deactivate S
@enduml
