@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 230
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD07 · Đăng ký làm thêm giờ (Tăng ca)\n<size:12>Mobile – Phần 1/2: Tải loại tăng ca và lịch sử trong tháng</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "OvertimeManageScreen" as S
participant "OvertimeRequestModal" as M
end box
box "Domain" #FEF9E7
participant "UseCases" as UC
end box
box "Data" #EEF2FF
participant "RequestsRepository\n→ RemoteDataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API" as API
end box


hide unlinked

U -> S : Trang chủ / Tất cả dịch vụ → "Tăng ca"
S -> UC : GetOvertimeTypesUseCase()
UC -> REPO : getOvertimeTypes()
REPO -> API : GET /api/OvertimeTypes/fetch?IsActive=1
alt Có danh mục
  API --> REPO : items[{code, name, scale}]
else Rỗng / lỗi
  REPO -> API : GET /api/OvertimeRequests/self?init=1
  API --> REPO : overtimeTypes[]
end
REPO -> REPO : Bỏ mục giữ chỗ ("default")
REPO --> UC : List‹OvertimeTypeEntity›
UC --> S : loại tăng ca + hệ số
S -> UC : GetOvertimeRequestsUseCase(month)
UC -> REPO : getOvertimeRequests()
REPO -> API : GET /api/OvertimeRequests/self?month=yyyy-MM-01
API --> REPO : đơn tăng ca trong tháng
REPO --> UC : List‹OvertimeItemEntity›
UC --> S : lịch sử
S --> U : Tổng giờ tăng ca / giới hạn 40h tháng,\ndanh sách lọc theo trạng thái
@enduml
