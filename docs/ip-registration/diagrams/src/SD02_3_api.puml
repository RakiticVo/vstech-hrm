@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD02 · Chấm công vào / ra ca bằng nhận diện khuôn mặt AI (trực tuyến)\n<size:12>Tầng 3 – API (hợp đồng giao tiếp)</size>
participant "Ứng dụng Mobile\n<size:10>DioClient / FaceDioClient</size>" as APP
box "Máy chủ" #FFF1F2
participant "Face Authentication API\n<size:10>REST · multipart</size>" as FACE
participant "HRM Backend API\n<size:10>REST · JSON · JWT</size>" as HRM
end box
APP -> FACE : <b>GET /checkreg/</b>\nQuery: Code (mã NV), AppCode
activate FACE
note over FACE : Xử lý nội bộ: <color:#B91C1C><i>[API bổ sung]</i></color>\n(xác thực, kiểm tra quyền, quy tắc nghiệp vụ)
alt Thành công
  FACE --> APP : <b>200 OK</b>\n{status, registered, count, message}
else 422
  FACE --> APP : <b>422</b>\nHTTPValidationError{detail[]}
end
deactivate FACE
APP -> FACE : <b>POST /verify/</b>\nmultipart/form-data: Code, AppCode, file (ảnh JPEG)
activate FACE
note over FACE : Xử lý nội bộ: <color:#B91C1C><i>[API bổ sung]</i></color>\n(xác thực, kiểm tra quyền, quy tắc nghiệp vụ)
alt Thành công
  FACE --> APP : <b>200 OK</b>\n{status, match, similarity, message}
else 422
  FACE --> APP : <b>422</b>\nHTTPValidationError{detail[]}
end
deactivate FACE
APP -> HRM : <b>POST /api/Enrollments/Checkin  (hoặc /Checkout)</b>\nHeader: Bearer ‹JWT› · Query: jsc\nBody EnrollForm{coordinate, local, ip4, ip6, fingerprint, time, date}
activate HRM
note over HRM : Xử lý nội bộ: <color:#B91C1C><i>[API bổ sung]</i></color>\n(xác thực, kiểm tra quyền, quy tắc nghiệp vụ)
alt Thành công
  HRM --> APP : <b>200 OK</b>\nEnrollActionResponse{message, checkin, checkout}
else 400
  HRM --> APP : <b>400</b>\nServiceResultResponse{message}
end
deactivate HRM
APP -> HRM : <b>GET /api/Enrollments/info</b>\nHeader: Bearer ‹JWT› · Query: date, time (tuỳ chọn)
activate HRM
note over HRM : Xử lý nội bộ: <color:#B91C1C><i>[API bổ sung]</i></color>\n(xác thực, kiểm tra quyền, quy tắc nghiệp vụ)
alt Thành công
  HRM --> APP : <b>200 OK</b>\nEnrollmentInfoResponse{timesheet, enroll, startShift, startBreak,\nendBreak, endShift, enrolls[], isValidCheckIn, facialDisabled, serverTime}
else 400
  HRM --> APP : <b>400</b>\nServiceResultResponse{message}
end
deactivate HRM
@enduml
