@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD10 · Quản lý phê duyệt đơn của nhân viên cấp dưới (vai trò Quản lý)\n<size:12>Tầng 1 – Mobile App</size>
actor "Quản lý trực tiếp" as U
box "Presentation" #E6F4F1
participant "GoRouter\n(guard theo vai trò)" as R
participant "HomeScreen\n(dải Chờ duyệt)" as H
participant "ApprovalsScreen\n+ ApprovalCard" as S
participant "ConfirmTimesheetDialog /\nmodal lý do từ chối" as DLG
end box
box "Domain" #FEF9E7
participant "GetPendingApprovals /\nApprove* / Reject* UseCase" as UC
end box
box "Data" #EEF2FF
participant "ApprovalsRepositoryImpl" as REPO
participant "ApprovalsRemoteDataSource" as DS
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API\n<size:10>REST · JWT</size>" as API
end box


U -> H : Mở Trang chủ
H -> UC : GetPendingApprovalsUseCase()
UC -> REPO : getPendingTimesheetApprovals()
REPO -> DS : getPendingTimesheetCorrections()
DS -> API : GET /api/TimesheetConfirmRequests?personal=false
API --> DS : TimesheetConfirmRequestQuery[]
DS --> REPO : models
REPO --> UC : Right(List‹CorrectionItemEntity›)
UC --> H : Số đơn chờ duyệt → dải "Chờ duyệt" + badge
U -> H : Chạm dải "Chờ duyệt" / tab "Phê duyệt"
H -> R : go(/approvals)
R -> R : authRedirectGuard: role.isManager ?
alt Không phải Quản lý
  R --> H : Chuyển hướng về /home
else Quản lý
  R -> S : Mở ApprovalsScreen
end
activate S
S -> UC : GetPendingApprovalsUseCase()
UC --> S : Danh sách đơn chờ duyệt
S --> U : Thẻ đơn: nhân viên, loại đơn, ngày,\nlý do, giờ công; lọc theo loại

alt Duyệt phiếu giải trình công
  U -> S : Bấm "Duyệt"
  S -> DLG : ConfirmTimesheetDialog.show(item)
  U -> DLG : Nhập số giờ công xác nhận + ghi chú
  DLG --> S : onConfirm(hours, note)
  S -> UC : ApproveTimesheetCorrectionUseCase(id, confirmedWorktime, note)
  UC -> REPO : approveTimesheetCorrection(id, …)
  REPO -> DS : approveTimesheetCorrection(id, command)
  DS -> API : POST /api/TimesheetConfirmRequests/confirm/{id}\n{confirmedWorktime, confirmNote}
  API --> DS : ServiceResultResponse{message}
else Từ chối (lý do bắt buộc)
  U -> S : Bấm "Từ chối"
  S -> DLG : Modal nhập lý do từ chối
  U -> DLG : Nhập lý do
  DLG --> S : reason
  S -> UC : RejectTimesheetCorrectionUseCase(id, note: reason)
  UC -> REPO : rejectTimesheetCorrection(id, note)
  REPO -> DS : rejectTimesheetCorrection(id, note)
  DS -> API : POST /api/TimesheetConfirmRequests/reject/{id}?note=…
  API --> DS : ServiceResultResponse{message}
else Duyệt / từ chối đơn nghỉ phép
  S -> UC : ApproveLeaveUseCase(id) / RejectLeaveUseCase(id)
  UC -> REPO : approveLeave(id) / rejectLeave(id)
  REPO -> DS : approveLeave / rejectLeave
  DS -> API : GET /api/ConfirmRequests/leave/accept|deny/{id}
  API --> DS : ServiceResultResponse
else Duyệt / từ chối đơn tăng ca
  S -> UC : ApproveOvertimeUseCase(id) / RejectOvertimeUseCase(id)
  UC -> REPO : approveOvertime(id) / rejectOvertime(id)
  REPO -> DS : approveOvertime / rejectOvertime
  DS -> API : GET /overtime/accept|Deny/{id}
  API --> DS : ServiceResultResponse
end
DS --> REPO : ServiceResultResponseModel
REPO --> UC : Right(ApprovalResultEntity) / Left(ServerFailure)
UC --> S : kết quả
alt Thành công
  S -> S : Xoá thẻ khỏi danh sách
  S --> U : SnackBar "Đã xác nhận / đã từ chối đơn của {tên NV}"
else Thất bại
  S --> U : SnackBar lỗi
end
deactivate S
@enduml
