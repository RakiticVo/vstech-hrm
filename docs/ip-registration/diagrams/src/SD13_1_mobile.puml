@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD13 · Trung tâm thông báo và đăng ký nhận thông báo đẩy\n<size:12>Tầng 1 – Mobile App</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "NotificationsScreen" as S
participant "HomeAnnouncements" as HA
participant "GoRouter" as R
end box
box "Domain" #FEF9E7
participant "GetNotifications / MarkRead /\nMarkAllRead / RegisterFcmToken\nUseCase" as UC
end box
box "Data" #EEF2FF
participant "NotificationsRepositoryImpl\n→ RemoteDataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API\n<size:10>REST · JWT</size>" as API
end box


== Đăng ký thiết bị nhận thông báo đẩy ==
UC -> REPO : RegisterFcmTokenUseCase(token, userName)
REPO -> API : GET /api/FCM/set-token?token&userName
API --> REPO : 200 "OK"

== Xem và xử lý thông báo ==
U -> HA : Trang chủ – khối "Cập nhật mới"
HA -> UC : GetNotificationsUseCase()
UC -> REPO : getNotifications(size, isRead)
REPO -> API : GET /api/BaseNotifications?size=2000&isRead=0
API --> REPO : BaseNotificationsResponse{data[], deptData[]}
REPO --> UC : Right(List‹NotificationEntity›)
UC --> HA : 3 thông báo mới nhất
U -> S : Mở "Thông báo"
S -> UC : GetNotificationsUseCase()
UC --> S : Danh sách
S --> U : Nhóm: Công ty · Đơn từ · Chấm công · Lương\nchấm đỏ = chưa đọc
U -> S : Chạm 1 thông báo
S -> UC : MarkNotificationReadUseCase(id)
UC -> REPO : markAsRead(id)
REPO -> API : GET /api/BaseNotifications/{id}/read
API --> REPO : 200
S -> R : Điều hướng theo keyPage\n(đơn từ / phiếu lương / chấm công)
opt Đánh dấu tất cả đã đọc
  U -> S : Bấm "Đọc tất cả"
  S -> UC : MarkAllNotificationsReadUseCase()
  UC -> REPO : markAllAsRead()
  REPO -> API : GET /api/BaseNotifications/read-all
  API --> REPO : 200
end
@enduml
