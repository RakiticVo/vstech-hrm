@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 230
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD10 · Bảng lương và phiếu lương có bảo vệ sinh trắc học\n<size:12>Mobile – Phần 2/2: Phiếu lương chi tiết</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "PayrollScreen" as P
participant "PayslipLockScreen" as L
participant "PayslipDetailScreen" as D
end box
box "Thiết bị" #F1F5F9
participant "local_auth" as BIO
end box
box "Domain" #FEF9E7
participant "GetPayslipDetail\nUseCase" as UC
end box
box "Data" #EEF2FF
participant "PayrollRepository\n→ DataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API" as API
end box


hide unlinked

D -> UC : GetPayslipDetailUseCase(id)
UC -> REPO : getPayslipDetail(id)
REPO -> API : GET /api/EmployeeSalaryPayrolls/detail/{id}
API --> REPO : bản ghi lương của kỳ
REPO -> REPO : PayslipDetailModel.fromJson\n→ PayslipEntity
REPO --> UC : PayslipEntity
UC --> D : dữ liệu phiếu lương
D --> U : Thu nhập: lương thực tế, phụ cấp, tăng ca, KPI\nKhấu trừ: BHXH/BHYT/BHTN, thuế TNCN, công đoàn\n→ Lương thực nhận
@enduml
