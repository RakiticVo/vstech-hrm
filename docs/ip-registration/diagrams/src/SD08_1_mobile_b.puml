@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 230
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD08 · Giải trình / điều chỉnh công (vai trò Quản lý)\n<size:12>Mobile – Phần 2/2: Lập và gửi phiếu giải trình</size>
actor "Quản lý" as U
box "Presentation" #E6F4F1
participant "CorrectionManageScreen" as L
participant "AttendanceCorrection\nScreen + Modal" as S
end box
box "Thiết bị" #F1F5F9
participant "Ảnh · GPS" as DEV
end box
box "Domain" #FEF9E7
participant "UseCases" as UC
end box
box "Data" #EEF2FF
participant "RequestsRepository\n→ RemoteDataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API" as API
end box


hide unlinked

U -> S : Ngày → vấn đề + giờ thực tế → giải trình
opt Lý do yêu cầu ảnh
  S -> DEV : Chụp / chọn ảnh, lấy vị trí
  DEV --> S : ảnh, toạ độ, địa chỉ
end
S -> S : Kiểm tra ghi chú / ảnh bắt buộc theo lý do
S -> UC : CreateCorrectionRequestUseCase(params)
UC -> REPO : createCorrectionRequest()
REPO -> API : POST /api/TimesheetConfirmRequests\n{workDate, worktime, reasonTypeCode,\nnote, imageUrl, latitude, longitude, address}
alt 200 OK
  API --> REPO : {message}
  REPO --> UC : Right(true)
  UC --> S : thành công
  S --> U : "Đã gửi phiếu giải trình"
else 400
  API --> REPO : {message}
  REPO --> UC : Left(Failure)
  UC --> S : Failure
  S --> U : Thông báo lỗi
end
@enduml
