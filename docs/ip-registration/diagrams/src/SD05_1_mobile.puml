@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD05 · Tra cứu lịch sử chấm công, bảng công tháng và ngày lễ\n<size:12>Tầng 1 – Mobile App</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "AttendanceScreen\n(Daily Log / Month)" as S
participant "CalendarScreen\n(5 mã màu)" as CAL
participant "HolidaysScreen" as HS
end box
box "Domain" #FEF9E7
participant "GetAttendanceHistory /\nGetTodayAttendance UseCase" as UC
participant "GetHolidaysUseCase" as UCH
end box
box "Data" #EEF2FF
participant "AttendanceRepositoryImpl\n→ RemoteDataSource" as AR
participant "HolidaysRepositoryImpl\n→ RemoteDataSource" as HR
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API\n<size:10>REST · JWT</size>" as API
end box


U -> S : Mở tab "Chấm công"
S -> UC : GetTodayAttendanceUseCase()
UC -> AR : getTodayAttendance()
AR -> API : GET /api/Enrollments/info
API --> AR : EnrollmentInfoResponse{timesheet, startShift,\nendShift, startBreak, endBreak, enroll, serverTime}
AR --> UC : Right(AttendanceTodayEntity)
UC --> S : Ca hôm nay, giờ vào/ra, trạng thái
S -> UC : GetAttendanceHistoryUseCase(from, to)
UC -> AR : getAttendanceHistory(from, to)
AR -> API : GET /api/Enrollments/info?from&to
API --> AR : enrolls[] {date, checkin, checkout, late, early, total}
AR -> AR : Chuyển giờ máy chủ (UTC) → giờ Việt Nam (UTC+7)\nPhân loại: late > 0 → "Đi muộn", ngược lại "Đúng giờ"
AR --> UC : Right(List‹AttendanceRecordEntity›)
UC --> S : Danh sách theo ngày
S --> U : Nhật ký chấm công từng ngày + thẻ tổng hợp tháng\n(ngày công, số lần muộn/sớm, tổng giờ)

U -> CAL : Mở "Bảng công tháng"
CAL -> CAL : Tô màu từng ngày theo 5 mã chuẩn hoá:\nXanh – đủ công · Vàng – muộn/sớm · Đỏ – thiếu công\nTím – nghỉ phép · Xám – nghỉ tuần / lễ
U -> CAL : Chạm ngày màu đỏ
CAL --> U : Lối tắt tạo phiếu giải trình (SD09)

U -> HS : Mở "Ngày lễ"
HS -> UCH : GetHolidaysUseCase()
UCH -> HR : getHolidays()
HR -> API : GET /api/Holidays
API --> HR : HolidaysResponse{items[{code, name, date, symbol, scale, isActive}]}
HR --> UCH : Right(List‹HolidayEntity›)
UCH --> HS : Danh sách ngày lễ
HS --> U : Ngày lễ quốc gia và ngày nghỉ bù trong năm
@enduml
