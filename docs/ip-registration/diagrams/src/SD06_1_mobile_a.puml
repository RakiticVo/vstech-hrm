@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 230
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD06 · Trung tâm yêu cầu – theo dõi đơn theo tháng\n<size:12>Mobile – Tải và xem đơn theo tháng</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "RequestsScreen" as S
participant "RequestDetailScreen" as D
end box
box "Domain" #FEF9E7
participant "UseCases" as UC
end box
box "Data" #EEF2FF
participant "RequestsRepository\n→ RemoteDataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API" as API
end box


hide unlinked

U -> S : Mở tab "Yêu cầu", chọn tháng
S -> UC : GetLeaveRequestsUseCase(from, to)
UC -> REPO : getLeaveRequests()
REPO -> API : GET /api/LeaveRequests/self?From&To
API --> REPO : đơn nghỉ phép
S -> UC : GetOvertimeRequestsUseCase(month)
UC -> REPO : getOvertimeRequests()
REPO -> API : GET /api/OvertimeRequests/self?month
API --> REPO : đơn tăng ca
REPO --> UC : các danh sách
UC --> S : entities
S -> S : Gộp, sắp xếp theo thời gian gửi
S --> U : Danh mục Nghỉ phép / Tăng ca,\ndanh sách đơn, lọc theo trạng thái
U -> S : Chọn 1 đơn
S -> D : Mở /requests/detail
D --> U : Loại đơn, mã đơn, trạng thái,\ntiến trình phê duyệt 4 cấp
@enduml
