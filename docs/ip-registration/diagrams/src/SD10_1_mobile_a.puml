@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 230
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD10 · Bảng lương và phiếu lương có bảo vệ sinh trắc học\n<size:12>Mobile – Phần 1/2: Tab Bảng lương và cổng bảo vệ</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "PayrollScreen" as P
participant "PayslipLockScreen" as L
participant "PayslipDetailScreen" as D
end box
box "Thiết bị" #F1F5F9
participant "local_auth" as BIO
end box
box "Domain" #FEF9E7
participant "GetPayslipDetail\nUseCase" as UC
end box
box "Data" #EEF2FF
participant "PayrollRepository\n→ DataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API" as API
end box


hide unlinked

U -> P : Mở tab "Bảng lương"
P -> UC : GetPayslipDetailUseCase(id)
UC -> REPO : getPayslipDetail(id)
REPO -> API : GET /api/EmployeeSalaryPayrolls/detail/{id}
API --> REPO : {data{item: EmployeeSalaryPayroll}}
REPO --> UC : PayslipEntity
UC --> P : thực nhận, thu nhập, khấu trừ
P --> U : Lương NET (bấm mắt để ẩn/hiện),\nchi tiết thu nhập & khấu trừ, lịch sử kỳ lương
U -> P : Bấm "Xem phiếu lương"
P -> L : Mở /payroll/lock
L -> BIO : isDeviceSupported(), authenticate()
alt Sinh trắc hợp lệ
  BIO --> L : true
  L -> D : Mở phiếu lương
else Không hỗ trợ / huỷ → mã PIN 6 số
  U -> L : Nhập PIN
  alt Đúng
    L -> D : Mở phiếu lương
  else Sai
    L -> L : Rung, giảm lượt (tối đa 5),\nhết lượt → khoá 30 giây
  end
end
@enduml
