@startuml

!pragma layout smetana
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 10
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam ArrowColor #0F766E
skinparam componentStyle rectangle
skinparam rectangle {
  BorderColor #0F766E
  BackgroundColor #FFFFFF
}
skinparam package {
  BorderColor #0A544E
  BackgroundColor #F0FDFA
  FontColor #0A544E
}
skinparam node {
  BorderColor #0A544E
  BackgroundColor #F8FAFC
}
skinparam database {
  BorderColor #0A544E
  BackgroundColor #ECFEFF
}
skinparam cloud {
  BorderColor #B45309
  BackgroundColor #FFFBEB
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
}
skinparam class {
  BorderColor #0F766E
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #CCFBF1
  ArrowColor #0F766E
}
skinparam state {
  BorderColor #0F766E
  BackgroundColor #F0FDFA
  ArrowColor #0F766E
}


title Sơ đồ điều hướng chính theo vai trò
left to right direction
rectangle "Splash" as SP
rectangle "Đăng nhập" as LG
rectangle "Ứng viên mới\n(Onboarding)" as OB
package "AppShell – Nhân viên (NV)" {
  rectangle "Trang chủ" as H1
  rectangle "Chấm công" as A1
  rectangle "Yêu cầu" as R1
  rectangle "Bảng lương" as P1
  rectangle "Cá nhân" as C1
}
package "AppShell – Quản lý (QL)" {
  rectangle "Trang chủ\n+ dải Chờ duyệt" as H2
  rectangle "Chấm công" as A2
  rectangle "Phê duyệt\n(badge số đơn)" as R2
  rectangle "Bảng lương" as P2
  rectangle "Cá nhân" as C2
}
rectangle "Tất cả dịch vụ\n(4 nhóm)" as SV
SP --> LG : chưa đăng nhập
SP --> H1 : vai trò NV
SP --> H2 : vai trò QL
SP --> OB : vai trò ứng viên
LG --> H1
LG --> H2
H1 --> SV
H2 --> SV
@enduml
