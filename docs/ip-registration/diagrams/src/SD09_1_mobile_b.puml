@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 230
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD09 · Phê duyệt đơn: giải trình công, nghỉ phép, tăng ca\n<size:12>Mobile – Phần 2/3: Duyệt đơn</size>
actor "Quản lý" as U
box "Presentation" #E6F4F1
participant "Home / GoRouter" as R
participant "ApprovalsScreen\n+ dialog" as S
participant "ApprovalsAction\nHandler" as H
end box
box "Domain" #FEF9E7
participant "UseCases" as UC
end box
box "Data" #EEF2FF
participant "Approvals / Requests\nRepository → DataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API" as API
end box


hide unlinked

U -> S : Bấm "Duyệt"
opt Phiếu giải trình công
  S --> U : Hộp thoại xác nhận giờ công
  U -> S : Số giờ xác nhận + ghi chú
end
S -> H : approve(item, hours, note)
alt Giải trình công
  H -> UC : ApproveTimesheetCorrectionUseCase
  UC -> REPO : approveTimesheetCorrection()
  REPO -> API : POST /api/TimesheetConfirmRequests/confirm/{id}\n{confirmedWorktime, confirmNote}
else Nghỉ phép
  H -> UC : ApproveLeaveUseCase
  UC -> REPO : approveLeave()
  REPO -> API : GET /api/ConfirmRequests/leave/accept/{id}
else Tăng ca
  H -> UC : ApproveOvertimeUseCase
  UC -> REPO : approveOvertime()
  REPO -> API : GET /overtime/accept/{id}
end
API --> REPO : {message}
REPO --> UC : Right / Left
UC --> H : kết quả
H --> S : thông báo của máy chủ / Failure
S --> U : Gỡ thẻ đơn + SnackBar (hoặc báo lỗi)
@enduml
