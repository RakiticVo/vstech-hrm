@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD07 · Trung tâm yêu cầu – xem tiến độ duyệt và thu hồi đơn\n<size:12>Tầng 1 – Mobile App</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "RequestsScreen" as S
participant "RequestDetailScreen\n+ RequestDetailTimeline" as D
participant "CancelRequestDialog" as CD
end box
box "Domain" #FEF9E7
participant "GetLeave / GetOvertime /\nGetCorrection Requests UseCase" as UCQ
participant "CancelLeave / CancelOvertime\nRequest UseCase" as UCC
end box
box "Data" #EEF2FF
participant "RequestsRepositoryImpl\n→ RemoteDataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API\n<size:10>REST · JWT</size>" as API
end box


U -> S : Mở tab "Yêu cầu"
activate S
par Tải song song 3 nguồn đơn
  S -> UCQ : GetLeaveRequestsUseCase()
  UCQ -> REPO : getLeaveRequests()
  REPO -> API : GET /api/LeaveRequests/self
  API --> REPO : results[]
else
  S -> UCQ : GetOvertimeRequestsUseCase()
  UCQ -> REPO : getOvertimeRequests()
  REPO -> API : GET /api/OvertimeRequests/self
  API --> REPO : OvertimeRequestSelfItem[]
else
  S -> UCQ : GetCorrectionRequestsUseCase(personal: true)
  UCQ -> REPO : getCorrectionRequests(personal: true)
  REPO -> API : GET /api/TimesheetConfirmRequests?personal=true
  API --> REPO : TimesheetConfirmRequestQuery[]
end
REPO --> UCQ : Right(entities)
UCQ --> S : 3 danh sách
S -> S : Gộp, sắp xếp theo thời gian gửi,\nđếm theo trạng thái
S --> U : Thẻ tổng hợp + chip lọc:\nChờ duyệt · Đã duyệt · Từ chối · Đã huỷ
U -> S : Chọn 1 đơn
S -> D : push(/requests/detail, request)
activate D
D --> U : Thông tin đơn + dòng thời gian duyệt 4 bước:\nNhân viên gửi → Quản lý duyệt → HR xác nhận → Giám đốc phê duyệt
opt Đơn đang "Chờ duyệt" – nhân viên muốn thu hồi
  U -> D : Bấm "Thu hồi đơn"
  D -> CD : show()
  U -> CD : Xác nhận
  CD --> D : true
  alt Đơn nghỉ phép
    D -> UCC : CancelLeaveRequestUseCase(id)
    UCC -> REPO : cancelLeaveRequest(id)
    REPO -> API : DELETE /api/LeaveRequests/self/{id}
  else Đơn tăng ca
    D -> UCC : CancelOvertimeRequestUseCase(id)
    UCC -> REPO : cancelOvertimeRequest(id)
    REPO -> API : DELETE /api/OvertimeRequests/self/{id}
  end
  alt 200 OK
    API --> REPO : ServiceResultResponse
    REPO --> UCC : Right(true)
    UCC --> D : thành công
    D --> S : pop(true) → tải lại danh sách
  else 400 – đơn đã được duyệt
    API --> REPO : ServiceResultResponse{message}
    REPO --> UCC : Left(ServerFailure)
    UCC --> D : Failure
    D --> U : Thông báo không thể thu hồi
  end
end
deactivate D
deactivate S
@enduml
