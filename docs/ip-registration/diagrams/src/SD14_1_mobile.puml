@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD14 · Hồ sơ nhân viên 360° và thiết bị đã đăng ký\n<size:12>Tầng 1 – Mobile App</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "ProfileScreen /\nProfileEditScreen" as S
participant "SettingsScreen /\nRegisteredDeviceScreen" as ST
participant "AuthCubit" as AC
end box
box "Data" #EEF2FF
participant "AuthRemoteDataSource\n(DioClient + JWT)" as DS
participant "FlutterSecureStorage" as SEC
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API\n<size:10>REST · JWT</size>" as API
end box


U -> S : Mở tab "Cá nhân"
S -> DS : getBasicInfo()
DS -> API : GET /api/Account/basic
API --> DS : EmployeeDynamicValueExt{name, gender, code,\ndepartmentCode, positionCode, statusValue}
S -> DS : getFullProfile()
DS -> API : GET /api/Account
API --> DS : EmployeeProfileResponse{employee, account,\ndanh mục: banks, cities, wards, eduLvls…}
DS --> S : Hồ sơ
S --> U : Thông tin cá nhân · Thông tin công việc ·\nHợp đồng · Người phụ thuộc · Tài liệu
opt Chỉnh sửa hồ sơ
  U -> S : Sửa thông tin cá nhân
  S --> U : Trường cá nhân → gửi HR duyệt (2 cấp);\nthông tin công việc chỉ được xem
end
U -> ST : Cài đặt → Bảo mật
ST --> U : Thiết bị chính đã đăng ký, trạng thái\nroot/jailbreak, giả lập GPS, sinh trắc học
opt Đăng xuất
  U -> ST : Bấm "Đăng xuất" → xác nhận
  ST -> AC : logout()
  AC -> SEC : delete(token, refresh_token, session, valid_to)
  AC -> AC : emit(Unauthenticated) → /login
end
@enduml
