@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 230
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD07 · Đăng ký làm thêm giờ (Tăng ca)\n<size:12>Mobile – Phần 2/2: Tạo đơn tăng ca</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "OvertimeManageScreen" as S
participant "OvertimeRequestModal" as M
end box
box "Domain" #FEF9E7
participant "UseCases" as UC
end box
box "Data" #EEF2FF
participant "RequestsRepository\n→ RemoteDataSource" as REPO
end box

box "Máy chủ" #FFF1F2
participant "HRM Backend API" as API
end box


hide unlinked

U -> S : Bấm "Đăng ký tăng ca"
S -> M : Mở form (danh mục loại tăng ca)
U -> M : Ngày, giờ bắt đầu – kết thúc,\nloại tăng ca, lý do
M -> M : Tự tính thời lượng; bắt buộc loại hợp lệ, lý do
M -> S : onConfirm(...)
S -> S : Chặn gửi trùng; ngày yyyy-MM-dd,\ngiờ yyyy-MM-ddTHH:mm:00
S -> UC : CreateOvertimeRequestUseCase(params)
UC -> REPO : createOvertimeRequest()
REPO -> REPO : Map → OvertimeRequestCreateModel
REPO -> API : POST /api/OvertimeRequests\n{date, length, note, startOvertime,\nendOvertime, overtimeTypeCode}
alt 200 OK
  API --> REPO : {message}
  REPO --> UC : Right(true)
  UC --> S : thành công
  S --> M : Đóng form
  S --> U : "Đã gửi đăng ký tăng ca"
else 400
  API --> REPO : {message}
  REPO --> UC : Left(ServerFailure(message))
  UC --> S : Failure
  S --> M : message
  M --> U : Giữ form, hiện banner lỗi của máy chủ
end
@enduml
