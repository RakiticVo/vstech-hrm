@startuml

skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0A544E
skinparam sequence {
  ArrowColor #0F766E
  ArrowThickness 1.2
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #CCFBF1
  ParticipantBorderColor #0F766E
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #0F766E
  ActorBackgroundColor #FFF8EC
  BoxBorderColor #CBD5E1
  GroupBorderColor #B45309
  GroupBackgroundColor #FFFBEB
  GroupHeaderFontColor #92400E
  DividerBackgroundColor #F0FDFA
  DividerBorderColor #0F766E
  ReferenceBackgroundColor #F8FAFC
}
skinparam note {
  BackgroundColor #FFF8EC
  BorderColor #F59E0B
  FontSize 11
}

autonumber "<b>00."
title SD12 · Khiếu nại sai lệch lương\n<size:12>Tầng 1 – Mobile App</size>
actor "Nhân viên" as U
box "Presentation" #E6F4F1
participant "PayslipDetailScreen" as D
participant "SalaryDisputeNewScreen" as N
participant "SalaryDisputeScreen" as L
end box
box "Máy chủ" #FFF1F2
participant "HRM Backend API\n(C&B)" as API
end box

U -> D : Chạm dòng lương có sai lệch
D -> N : push(/payroll/dispute-new, {item, amount, period})
activate N
N --> U : Thông tin dòng lương (chỉ đọc): kỳ lương,\nkhoản mục, số tiền hệ thống
U -> N : Nhập số tiền đúng theo nhân viên,\nmô tả chi tiết, đính kèm minh chứng
N -> N : Kiểm tra bắt buộc nhập, tính chênh lệch
U -> N : Bấm "Gửi khiếu nại"
N -> API : Gửi khiếu nại {payslipId, itemRef, description}
note right of API : Endpoint khiếu nại lương –\n[Backend bổ sung]
API --> N : Mã khiếu nại, trạng thái "Tiếp nhận"
N --> U : Xác nhận đã gửi – chuyển chuyên viên C&B xử lý
deactivate N
U -> L : Mở "Khiếu nại lương"
L --> U : Danh sách khiếu nại + trạng thái:\nTiếp nhận → Đang xử lý → Đã giải quyết
@enduml
